clear; clc; close all;

%% TRANSVERSELY ISOTROPIC MATERIAL (Carbon Fiber Sheet)
E1  = 150e9;     % along fiber
E2  = 10e9;      % in-plane
nu12 = 0.25;
G12 = 5e9;
G23 = 3.5e9;

% Compliance matrix (Voigt)
S = zeros(6,6);
S(1,1)=1/E1;  S(2,2)=1/E2;  S(3,3)=1/E2;
S(1,2)=-nu12/E1; S(1,3)=-nu12/E1;
S(2,1)=S(1,2);   S(3,1)=S(1,3);
S(4,4)=1/G23; S(5,5)=1/G12; S(6,6)=1/G12;

C = inv(S);   % stiffness matrix

%% INPUT DEFORMATION GRADIENT
dF = [1 3 0;
      0 1 0;
      0 0 1];

N = 50;   
dt = 1/N;
dF_inc = dF^(1/N);

F = eye(3);
sigma_s = zeros(6,1);
sigma_L = zeros(6,1);

eqE = zeros(N,1);
eqS_s = zeros(N,1);
eqS_L = zeros(N,1);

%% MAIN LOOP
for n = 1:N
    
    % deformation gradient update
    F = dF_inc * F;
    Finv = inv(F);

    % velocity gradient
    L = dF_inc * Finv;

    d = 0.5*(L + L');   % rate of deformation
    w = 0.5*(L - L');   % spin

    % Convert d to Voigt
    deps = [d(1,1); d(2,2); d(3,3); d(2,3); d(1,3); d(1,2)];

    %% SMALL STRAIN
    sigma_s = sigma_s + C*deps*dt;

    %% LARGE STRAIN (JAUMANN)
    sigma_tensor = [sigma_L(1) sigma_L(6) sigma_L(5);
                    sigma_L(6) sigma_L(2) sigma_L(4);
                    sigma_L(5) sigma_L(4) sigma_L(3)];

    sigma_rot = sigma_tensor + dt*(sigma_tensor*w - w*sigma_tensor);

    sigma_L = [sigma_rot(1,1); sigma_rot(2,2); sigma_rot(3,3); ...
               sigma_rot(2,3); sigma_rot(1,3); sigma_rot(1,2)] ...
               + C*deps*dt;

    % equivalent strain
    eqE(n) = n*sqrt(2/3*(deps(1)^2 + deps(2)^2 + deps(3)^2 ...
               + 0.5*(deps(4)^2 + deps(5)^2 + deps(6)^2)));

    % von mises
    eqS_s(n) = sqrt(1.5*(sigma_s(1)^2 + sigma_s(2)^2 + sigma_s(3)^2));
    eqS_L(n) = sqrt(1.5*(sigma_L(1)^2 + sigma_L(2)^2 + sigma_L(3)^2));
end

%% PLOT
plot(eqE,eqS_s,'LineWidth',2); hold on;
plot(eqE,eqS_L,'LineWidth',2);
xlabel("Equivalent Strain");
ylabel("Equivalent Stress (Pa)");
title("Carbon Fiber Sheet — Small vs Large Strain");
legend("Small Strain","Large Strain");
grid on;
